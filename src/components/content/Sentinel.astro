---
import SentinelTree from '../tree/SentinelTree.astro';
---

<section id="projects" class="w-full flex flex-col items-center bg-white dark:bg-gray-900 mb-16">
	<div class="flex justify-center -mt-80 mb-14">
		<div class="swiper">
			<div class="swiper-wrapper">
				<div class="swiper-slide !w-fit px-4">
					<img src="/media/internal/sentinel-img.png" alt="Hero Showcase Image" height="400" width="1000" class="rounded-lg border-gray-300 border">
				</div>
				<div class="swiper-slide !w-fit px-4">
					<img src="/media/internal/sentinel-2.png" alt="Hero Showcase Image" height="400" width="1000" class="rounded-lg border-gray-300 border">
				</div>
				<div class="swiper-slide !w-fit px-4">
					<img src="/media/internal/sentinel-3.png" alt="Hero Showcase Image" height="400" width="1000" class="rounded-lg border-gray-300 border">
				</div>
				<div class="swiper-slide !w-fit px-4">
					<img src="/media/internal/sentinel-4.png" alt="Hero Showcase Image" height="400" width="1000" class="rounded-lg border-gray-300 border">
				</div>
				<div class="swiper-slide !w-fit px-4">
					<img src="/media/internal/sentinel-5.png" alt="Hero Showcase Image" height="400" width="1000" class="rounded-lg border-gray-300 border">
				</div>
			</div>
		</div>
	</div>

	<div id="sentinel" class="px-4 max-w-4xl mt-6">
		<div class="flex flex-col lg:flex-row justify-between">
			<h2 class="font-bold text-4xl">Sentinel.</h2>

			<div class="mt-4 md:mt-0 w-full md:w-fit flex">
				<a href="#bundle" class="flex gap-1 items-center text-white bg-amber-700 hover:bg-amber-800 focus:ring-4 focus:ring-amber-300 font-medium rounded-lg text-sm px-3 md:px-5 py-2.5 me-2 mb-2 dark:bg-amber-600 dark:hover:bg-amber-700 focus:outline-none dark:focus:ring-amber-800">
					Buy the Code
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
						<path fill-rule="evenodd" d="M15.75 2.25H21a.75.75 0 0 1 .75.75v5.25a.75.75 0 0 1-1.5 0V4.81L8.03 17.03a.75.75 0 0 1-1.06-1.06L19.19 3.75h-3.44a.75.75 0 0 1 0-1.5Zm-10.5 4.5a1.5 1.5 0 0 0-1.5 1.5v10.5a1.5 1.5 0 0 0 1.5 1.5h10.5a1.5 1.5 0 0 0 1.5-1.5V10.5a.75.75 0 0 1 1.5 0v8.25a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3V8.25a3 3 0 0 1 3-3h8.25a.75.75 0 0 1 0 1.5H5.25Z" clip-rule="evenodd" />
					</svg>
				</a>
				<a href="https://sentinel.hubku.com?utm_medium=hubku.com" target="_blank" class="flex items-center gap-1 py-2.5 px-3 md:px-5 me-2 mb-2 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-orange-400 hover:bg-gray-100 hover:text-amber-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">
					Project Demo
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
						<path d="M21.721 12.752a9.711 9.711 0 0 0-.945-5.003 12.754 12.754 0 0 1-4.339 2.708 18.991 18.991 0 0 1-.214 4.772 17.165 17.165 0 0 0 5.498-2.477ZM14.634 15.55a17.324 17.324 0 0 0 .332-4.647c-.952.227-1.945.347-2.966.347-1.021 0-2.014-.12-2.966-.347a17.515 17.515 0 0 0 .332 4.647 17.385 17.385 0 0 0 5.268 0ZM9.772 17.119a18.963 18.963 0 0 0 4.456 0A17.182 17.182 0 0 1 12 21.724a17.18 17.18 0 0 1-2.228-4.605ZM7.777 15.23a18.87 18.87 0 0 1-.214-4.774 12.753 12.753 0 0 1-4.34-2.708 9.711 9.711 0 0 0-.944 5.004 17.165 17.165 0 0 0 5.498 2.477ZM21.356 14.752a9.765 9.765 0 0 1-7.478 6.817 18.64 18.64 0 0 0 1.988-4.718 18.627 18.627 0 0 0 5.49-2.098ZM2.644 14.752c1.682.971 3.53 1.688 5.49 2.099a18.64 18.64 0 0 0 1.988 4.718 9.765 9.765 0 0 1-7.478-6.816ZM13.878 2.43a9.755 9.755 0 0 1 6.116 3.986 11.267 11.267 0 0 1-3.746 2.504 18.63 18.63 0 0 0-2.37-6.49ZM12 2.276a17.152 17.152 0 0 1 2.805 7.121c-.897.23-1.837.353-2.805.353-.968 0-1.908-.122-2.805-.353A17.151 17.151 0 0 1 12 2.276ZM10.122 2.43a18.629 18.629 0 0 0-2.37 6.49 11.266 11.266 0 0 1-3.746-2.504 9.754 9.754 0 0 1 6.116-3.985Z" />
					</svg>
				</a>
			</div>
		</div>
		<p class="mt-4">Sentinel is a web application designed to gather and analyze events from your own applications. Collect events from your client, send them to Sentinel via HTTP requests, and it will store and analyze your data for you. It even features a powerful AI agent that allows you to chat and receive summaries of your data in a natural, conversational manner.</p>

		<div class="my-8 lg:mb-16">
			<div class="flex gap-8 items-center">
				<h2 class="font-bold text-2xl">Features</h2>
				<hr class="flex-1 h-px my-8 bg-gray-300 border-0 dark:bg-gray-700">
			</div>
			<p class="mt-2 text-sm">Check out the features Sentinel is packed with. The standout? Lightning-fast Artificial Intelligence insights just for you.</p>

			<div class="mt-12">
				<div class="space-y-8 justify-center md:grid md:grid-cols-2 md:gap-12 md:space-y-0">
					<div class="flex flex-col items-center justify-center">
						<div class="flex justify-center items-center mb-4">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 text-amber-500">
								<path fill-rule="evenodd" d="M9 4.5a.75.75 0 0 1 .721.544l.813 2.846a3.75 3.75 0 0 0 2.576 2.576l2.846.813a.75.75 0 0 1 0 1.442l-2.846.813a3.75 3.75 0 0 0-2.576 2.576l-.813 2.846a.75.75 0 0 1-1.442 0l-.813-2.846a3.75 3.75 0 0 0-2.576-2.576l-2.846-.813a.75.75 0 0 1 0-1.442l2.846-.813A3.75 3.75 0 0 0 7.466 7.89l.813-2.846A.75.75 0 0 1 9 4.5ZM18 1.5a.75.75 0 0 1 .728.568l.258 1.036c.236.94.97 1.674 1.91 1.91l1.036.258a.75.75 0 0 1 0 1.456l-1.036.258c-.94.236-1.674.97-1.91 1.91l-.258 1.036a.75.75 0 0 1-1.456 0l-.258-1.036a2.625 2.625 0 0 0-1.91-1.91l-1.036-.258a.75.75 0 0 1 0-1.456l1.036-.258a2.625 2.625 0 0 0 1.91-1.91l.258-1.036A.75.75 0 0 1 18 1.5ZM16.5 15a.75.75 0 0 1 .712.513l.394 1.183c.15.447.5.799.948.948l1.183.395a.75.75 0 0 1 0 1.422l-1.183.395c-.447.15-.799.5-.948.948l-.395 1.183a.75.75 0 0 1-1.422 0l-.395-1.183a1.5 1.5 0 0 0-.948-.948l-1.183-.395a.75.75 0 0 1 0-1.422l1.183-.395c.447-.15.799-.5.948-.948l.395-1.183A.75.75 0 0 1 16.5 15Z" clip-rule="evenodd"></path>
							</svg>
						</div>
						<h3 class="mb-2 text-xl font-bold dark:text-white">AI Powered Insights</h3>
						<p class="text-gray-500 dark:text-gray-400">AI agent to quickly summarize your data.</p>
					</div>
					<div class="flex flex-col items-center justify-center">
						<div class="flex justify-center items-center mb-4">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 text-blue-600">
								<path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 0 1 .359.852L12.982 9.75h7.268a.75.75 0 0 1 .548 1.262l-10.5 11.25a.75.75 0 0 1-1.272-.71l1.992-7.302H3.75a.75.75 0 0 1-.548-1.262l10.5-11.25a.75.75 0 0 1 .913-.143Z" clip-rule="evenodd"></path>
							</svg>
						</div>
						<h3 class="mb-2 text-xl font-bold dark:text-white">Near Real Time</h3>
						<p class="text-gray-500 dark:text-gray-400">See user events as they happen.</p>
					</div>
					<div class="flex flex-col items-center justify-center">
						<div class="flex justify-center items-center mb-4">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 text-purple-600">
								<path fill-rule="evenodd" d="M2.25 13.5a8.25 8.25 0 0 1 8.25-8.25.75.75 0 0 1 .75.75v6.75H18a.75.75 0 0 1 .75.75 8.25 8.25 0 0 1-16.5 0Z" clip-rule="evenodd"></path>
								<path fill-rule="evenodd" d="M12.75 3a.75.75 0 0 1 .75-.75 8.25 8.25 0 0 1 8.25 8.25.75.75 0 0 1-.75.75h-7.5a.75.75 0 0 1-.75-.75V3Z" clip-rule="evenodd"></path>
							</svg>
						</div>
						<h3 class="mb-2 text-xl font-bold dark:text-white">Useful Summary</h3>
						<p class="text-gray-500 dark:text-gray-400">Crystal clear insights into user behavior.</p>
					</div>
					<div class="flex flex-col items-center justify-center">
						<div class="flex justify-center items-center mb-4">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 text-green-600">
								<path fill-rule="evenodd" d="M1.5 7.125c0-1.036.84-1.875 1.875-1.875h6c1.036 0 1.875.84 1.875 1.875v3.75c0 1.036-.84 1.875-1.875 1.875h-6A1.875 1.875 0 0 1 1.5 10.875v-3.75Zm12 1.5c0-1.036.84-1.875 1.875-1.875h5.25c1.035 0 1.875.84 1.875 1.875v8.25c0 1.035-.84 1.875-1.875 1.875h-5.25a1.875 1.875 0 0 1-1.875-1.875v-8.25ZM3 16.125c0-1.036.84-1.875 1.875-1.875h5.25c1.036 0 1.875.84 1.875 1.875v2.25c0 1.035-.84 1.875-1.875 1.875h-5.25A1.875 1.875 0 0 1 3 18.375v-2.25Z" clip-rule="evenodd"></path>
							</svg>
						</div>
						<h3 class="mb-2 text-xl font-bold dark:text-white">Project Based Event</h3>
						<p class="text-gray-500 dark:text-gray-400">Divide & organize events as easy as cake.</p>
					</div>
					<div class="flex flex-col items-center justify-center">
						<div class="flex justify-center items-center mb-4">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 text-red-600">
								<path fill-rule="evenodd" d="M15.75 1.5a6.75 6.75 0 0 0-6.651 7.906c.067.39-.032.717-.221.906l-6.5 6.499a3 3 0 0 0-.878 2.121v2.818c0 .414.336.75.75.75H6a.75.75 0 0 0 .75-.75v-1.5h1.5A.75.75 0 0 0 9 19.5V18h1.5a.75.75 0 0 0 .53-.22l2.658-2.658c.19-.189.517-.288.906-.22A6.75 6.75 0 1 0 15.75 1.5Zm0 3a.75.75 0 0 0 0 1.5A2.25 2.25 0 0 1 18 8.25a.75.75 0 0 0 1.5 0 3.75 3.75 0 0 0-3.75-3.75Z" clip-rule="evenodd" />
							</svg>
						</div>
						<h3 class="mb-2 text-xl font-bold dark:text-white">Key Based Communication</h3>
						<p class="text-gray-500 dark:text-gray-400">Easy to use API with key as authentication.</p>
					</div>
					<div class="flex flex-col items-center justify-center">
						<div class="flex justify-center items-center mb-4">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 text-brown-600">
								<path fill-rule="evenodd" d="M19.5 21a3 3 0 0 0 3-3V9a3 3 0 0 0-3-3h-5.379a.75.75 0 0 1-.53-.22L11.47 3.66A2.25 2.25 0 0 0 9.879 3H4.5a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h15Zm-6.75-10.5a.75.75 0 0 0-1.5 0v4.19l-1.72-1.72a.75.75 0 0 0-1.06 1.06l3 3a.75.75 0 0 0 1.06 0l3-3a.75.75 0 1 0-1.06-1.06l-1.72 1.72V10.5Z" clip-rule="evenodd"></path>
							</svg>
						</div>
						<h3 class="mb-2 text-xl font-bold dark:text-white">Download-able Data</h3>
						<p class="text-gray-500 dark:text-gray-400">Easily export your event data into various formats.</p>
					</div>
				</div>
			</div>
		</div>

		<div class="my-8 lg:my-16">
			<div class="flex gap-8 items-center">
				<h2 class="font-bold text-2xl">Technologies</h2>
				<hr class="flex-1 h-px my-8 bg-gray-300 border-0 dark:bg-gray-700">
			</div>
			<p class="mt-2 text-sm">Check out the technology Sentinel is built on. Ask your engineer — they’ll tell you, these techs are 🔥!</p>

			<div class="mt-12">
				<div class="space-y-8 justify-center items-center grid grid-cols-2 md:grid-cols-4 md:gap-12 md:space-y-0">
					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/golang.png" alt="golang" width="150" height="100">
						<p class="text-sm text-center">Go Programming Language</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/gofiber.png" alt="gofiber" width="200" height="100">
						<p class="text-sm text-center">Go:Fiber Framework</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/postgres.png" alt="postgresql" width="130" height="100">
						<p class="text-sm">PostgreSQL Database</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/sqlc.png" alt="sqlc" width="200" height="200">
						<p class="text-sm">SQLC</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/redis.png" alt="redis" width="130" height="100">
						<p class="text-sm">Redis Database</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/javascript.png" alt="Golang" width="130" height="100">
						<p class="text-sm">JavaScript</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/htmx.png" alt="htmx" width="150" height="100">
						<p class="text-sm">HTMX</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/alpinejs.png" alt="alpinejs" width="100" height="100">
						<p class="text-sm">AlpineJS</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/jquery.png" alt="jquery" width="100" height="100">
						<p class="text-sm">JQuery</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/tailwindcss.png" alt="tailwindcss" width="100" height="100">
						<p class="text-sm">Tailwind CSS</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/nodejs.png" alt="nodejs" width="100" height="100">
						<p class="text-sm">NodeJS</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/langchain.png" alt="langchain" width="100" height="100">
						<p class="text-sm">Langchain</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/openai.png" alt="openai" width="100" height="100">
						<p class="text-sm">OpenAI</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/playwright.png" alt="playwright" width="100" height="100">
						<p class="text-sm">Playwright</p>
					</div>

					<div class="flex flex-col items-center gap-4">
						<img src="/media/tech/icons/docusaurus.png" alt="docusaurus" width="100" height="100">
						<p class="text-sm">Docusaurus</p>
					</div>
				</div>
			</div>
		</div>

		<div class="my-8 lg:my-16">
			<div class="flex gap-8 items-center">
				<h2 class="font-bold text-2xl">Source Code Available</h2>
				<hr class="flex-1 h-px my-8 bg-gray-300 border-0 dark:bg-gray-700">
			</div>

			<p class="mt-2 text-sm">Sentinel uses a monolith architecture, making it simple to use. But it also comes with multiple complementary services like an AI agent, documentation, UI end-to-end testing, and more.</p>

			<div class="mt-12 flex flex-wrap items-center justify-center gap-4">
				<div class="block max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">
					<h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Sentinel (Main Code)</h5>
					<p class="font-normal text-gray-700 dark:text-gray-400">Go:Fiber application along with PostgreSQL and Redis.</p>
				</div>

				<div class="block max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">
					<h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Sentinel AI Agent</h5>
					<p class="font-normal text-gray-700 dark:text-gray-400">NodeJS server to handle AI use-case from Sentinel main code. Integrated with Langchain and OpenAI.</p>
				</div>

				<div class="block max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">
					<h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Sentinel GUI Documentation</h5>
					<p class="font-normal text-gray-700 dark:text-gray-400">Web-based full documentation readily available built using Docusaurus.</p>
				</div>

				<div class="block max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">
					<h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Sentinel UI Test</h5>
					<p class="font-normal text-gray-700 dark:text-gray-400">End-to-end test built using Playwright to fully test UI capability of Sentinel.</p>
				</div>
			</div>

			<div class="my-8 lg:my-16">
				<div class="flex gap-8 items-center">
					<h2 class="font-bold text-2xl">Folder Structure</h2>
					<hr class="flex-1 h-px my-8 bg-gray-300 border-0 dark:bg-gray-700">
				</div>

				<p class="mt-2 text-sm">See how Sentinel's folder is organized. Here's what you'll find inside the .zip file for each source code package.</p>

				<div class="mt-10">
					<SentinelTree/>
				</div>
			</div>

			<div id="bundle" class="my-8 lg:my-16">

				<div class="mt-12 flex flex-col lg:flex-row-reverse items-center justify-center gap-10">
					<div class="gap-8 items-center">
						<h2 class="font-bold text-2xl">Pricing</h2>
						<p class="mt-2 text-sm">We offer bundles for you to choose from — whether you want just the main source code or the complete complementary bundle, we've got you covered.</p>

						<hr class="flex-1 h-px my-8 bg-gray-300 border-0 dark:bg-gray-700">

						<button type="button" class="text-white bg-orange-600 focus:ring-4 focus:outline-none focus:ring-blue-200 dark:bg-blue-600 hover:bg-orange-500 dark:hover:bg-orange-700 dark:focus:ring-blue-900 font-medium rounded-lg text-sm px-5 py-2.5 inline-flex justify-center w-full text-center">Buy the Code</button>
					</div>

					<div class="w-full max-w-sm p-4 bg-white border border-gray-200 rounded-lg shadow sm:p-8 dark:bg-gray-800 dark:border-gray-700">
						<h5 class="mb-4 text-xl font-medium text-gray-500 dark:text-gray-400">Complete Bundle</h5>
						<div class="flex items-baseline text-gray-900 dark:text-white">
							<span class="ml-4">
								<span class="text-3xl font-semibold">$</span>
								<span class="text-5xl font-extrabold tracking-tight">69</span>
							</span>
							<span class="ms-1 text-xl font-normal text-gray-500 dark:text-gray-400">/lifetime</span>
						</div>
						<ul role="list" class="space-y-5 my-7">
							<li class="flex items-center">
								<svg class="flex-shrink-0 w-4 h-4 text-orange-500 dark:text-orange-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
									<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z"/>
								</svg>
								<span class="text-base font-normal leading-tight text-gray-500 dark:text-gray-400 ms-3">Full Ownership of the Code</span>
							</li>
							<li class="flex items-center">
								<svg class="flex-shrink-0 w-4 h-4 text-orange-500 dark:text-orange-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
									<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z"/>
