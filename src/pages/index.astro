---
import Layout from '../layouts/Layout.astro';
import MainNavbar from '../components/header/MainNavbar.astro';
import MainHero from '../components/hero/MainHero.astro';
import Sentinel from '../components/content/Sentinel.astro';
import AlgoV from '../components/content/AlgoV.astro';
import 'swiper/css';
---

<Layout title="Big Ideas with Perfect Software Collections | Hubku.com">
    <MainNavbar/>

    <main>
        <MainHero/>

        <Sentinel/>
        <!-- <AlgoV/> -->
    </main>

    <div class="fixed bottom-10 right-10">
        <button id="scroll-top">Back to Top</button>
    </div>
</Layout>

<script>
import Swiper from 'swiper';

new Swiper('.swiper', {
    initialSlide: 1,
    grabCursor: true,
    centeredSlides: true,
    slidesPerView: "auto",
});

const scrollToTopBtn = document.getElementById("scroll-top");
const showScrollToTopThreshold = 1000; // 1k px

window.addEventListener('scroll', () => {
    if (window.scrollY > showScrollToTopThreshold) {
        scrollToTopBtn?.classList.remove('hidden'); 
    } else {
        scrollToTopBtn?.classList.add('hidden');
    }
});

scrollToTopBtn?.addEventListener("click", function() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
});
</script>
