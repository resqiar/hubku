---
import Layout from '../layouts/Layout.astro';
import MainNavbar from '../components/header/MainNavbar.astro';
import MainHero from '../components/hero/MainHero.astro';
import 'swiper/css';
---

<Layout title="Big Ideas with Perfect Software Collections | Hubku.com">
    <MainNavbar/>

    <main>
        <MainHero/>

        <section id="projects" class="w-full flex flex-col items-center bg-white dark:bg-gray-900 my-16">
            <div class="px-4 max-w-4xl mt-6">
                <div class="flex flex-col lg:flex-row justify-between">
                    <h2 class="font-bold text-4xl">Sentinel.</h2>

                    <div class="mt-4 md:mt-0 w-full md:w-fit flex">
                        <button type="button" class="flex gap-1 items-center text-white bg-amber-700 hover:bg-amber-800 focus:ring-4 focus:ring-amber-300 font-medium rounded-lg text-sm px-3 md:px-5 py-2.5 me-2 mb-2 dark:bg-amber-600 dark:hover:bg-amber-700 focus:outline-none dark:focus:ring-amber-800">
                            Buy the Code
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                                <path fill-rule="evenodd" d="M15.75 2.25H21a.75.75 0 0 1 .75.75v5.25a.75.75 0 0 1-1.5 0V4.81L8.03 17.03a.75.75 0 0 1-1.06-1.06L19.19 3.75h-3.44a.75.75 0 0 1 0-1.5Zm-10.5 4.5a1.5 1.5 0 0 0-1.5 1.5v10.5a1.5 1.5 0 0 0 1.5 1.5h10.5a1.5 1.5 0 0 0 1.5-1.5V10.5a.75.75 0 0 1 1.5 0v8.25a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3V8.25a3 3 0 0 1 3-3h8.25a.75.75 0 0 1 0 1.5H5.25Z" clip-rule="evenodd" />
                            </svg>
                        </button>
                        <a href="sentinel.hubku.com" class="flex items-center gap-1 py-2.5 px-3 md:px-5 me-2 mb-2 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-orange-400 hover:bg-gray-100 hover:text-amber-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">
                            Project Demo
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                                <path fill-rule="evenodd" d="M16.72 7.72a.75.75 0 0 1 1.06 0l3.75 3.75a.75.75 0 0 1 0 1.06l-3.75 3.75a.75.75 0 1 1-1.06-1.06l2.47-2.47H3a.75.75 0 0 1 0-1.5h16.19l-2.47-2.47a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    </div>
                </div>
                <p class="mt-4">Lorem ipsum dolor sit amet consectetur adipisicing elit. Quibusdam, rerum dolore odit atque quidem, ex blanditiis sunt cupiditate libero nihil obcaecati vel nam quo quia, voluptatibus nobis similique excepturi adipisci.</p>

                <div class="my-8 lg:mb-16">
                    <h2 class="font-bold text-2xl">Features</h2>

                    <div class="mt-12">
                        <div class="space-y-8 justify-center md:grid md:grid-cols-2 md:gap-12 md:space-y-0">
                            <div class="flex flex-col items-center justify-center">
                                <div class="flex justify-center items-center mb-4">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 text-amber-500">
